{
  "schemaVersion": 1,
  "items": [
    {
      "id": "frequent-expressions",
      "title": "跨轨迹高频表达",
      "queries": [
        {
          "id": "expression-counts",
          "source": {
            "label": "Qwen3-8B预算实验可见思考文本",
            "files": [
              {
                "label": "32K档100个原始shard"
              }
            ],
            "filters": [
              "输出预算：32768",
              "每题保留一条轨迹",
              "字段：thinking_text",
              "不含prompt和最终回答"
            ],
            "caveats": [
              "100题为等hop诊断集合，只有一个生成seed。",
              "高频表达不等于无效推理或隐藏神经机制。"
            ],
            "metricDefinitions": [
              {
                "label": "出现次数和覆盖",
                "definition": "出现次数统计原词或词组在100条可见思考中的匹配次数；覆盖统计至少出现一次的轨迹数。"
              }
            ]
          },
          "columns": [
            "phrase",
            "total_occurrences",
            "trajectories_with_phrase"
          ],
          "rows": [
            {
              "phrase": "maybe",
              "total_occurrences": 2797,
              "trajectories_with_phrase": 100
            },
            {
              "phrase": "wait",
              "total_occurrences": 2601,
              "trajectories_with_phrase": 100
            },
            {
              "phrase": "alternatively",
              "total_occurrences": 906,
              "trajectories_with_phrase": 91
            },
            {
              "phrase": "let me try",
              "total_occurrences": 816,
              "trajectories_with_phrase": 96
            },
            {
              "phrase": "coordinates",
              "total_occurrences": 726,
              "trajectories_with_phrase": 95
            },
            {
              "phrase": "let me think",
              "total_occurrences": 620,
              "trajectories_with_phrase": 91
            },
            {
              "phrase": "for example",
              "total_occurrences": 566,
              "trajectories_with_phrase": 90
            }
          ],
          "methods": [
            {
              "language": "calculation",
              "code": "每条轨迹分别匹配英文原词／词组；总次数求和，覆盖数计入至少匹配一次的轨迹。"
            }
          ]
        }
      ]
    },
    {
      "id": "repeated-sentences",
      "title": "单条轨迹中的整句循环",
      "queries": [
