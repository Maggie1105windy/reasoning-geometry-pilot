          "source": {
            "label": "Qwen3-8B预算实验可见思考文本",
            "files": [
              {
                "label": "32K档100个原始shard"
              }
            ],
            "filters": [
              "输出预算：32768",
              "每题保留一条轨迹",
              "字段：thinking_text",
              "不含prompt和最终回答"
            ],
            "caveats": [
              "100题为等hop诊断集合，只有一个生成seed。",
              "高频表达不等于无效推理或隐藏神经机制。"
            ],
            "metricDefinitions": [
              {
                "label": "整句重复次数",
                "definition": "整句计数统一大小写、空白和句尾标点，保留实体字母与坐标。"
              }
            ]
          },
          "columns": [
            "row_id",
            "sentence",
            "count"
          ],
          "rows": [
            {
              "row_id": 91319,
