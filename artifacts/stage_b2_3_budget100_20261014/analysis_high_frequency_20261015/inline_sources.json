    {
      "id": "loop-concentration",
      "title": "4条截断轨迹集中贡献重复文本",
      "queries": [
        {
          "id": "repeat-concentration",
          "source": {
            "label": "Qwen3-8B预算实验可见思考文本",
            "files": [
              {
                "label": "32K档100个原始shard"
              }
            ],
            "filters": [
              "输出预算：32768",
              "每题保留一条轨迹",
              "字段：thinking_text",
              "不含prompt和最终回答"
            ],
            "caveats": [
              "100题为等hop诊断集合，只有一个生成seed。",
              "高频表达不等于无效推理或隐藏神经机制。",
              "精确句子重复只描述文本，不能直接估计无效推理比例。"
            ],
            "metricDefinitions": [
              {
                "label": "额外重复句词数",
                "definition": "每个规范化句保留第一次出现，其余出现次数乘以该句词数，再对所有句求和。"
              }
            ]
          },
          "columns": [
            "group",
            "n",
            "thinking_tokens",
            "words",
            "extra_repeated_sentence_words"
          ],
          "rows": [
            {
              "group": "all",
              "n": 100,
              "thinking_tokens": 659460,
              "words": 507319,
              "extra_repeated_sentence_words": 127357
            },
            {
              "group": "truncated",
              "n": 4,
              "thinking_tokens": 131068,
              "words": 107059,
              "extra_repeated_sentence_words": 98441
            }
          ],
          "methods": [
            {
              "language": "calculation",
              "code": "4条截断轨迹思考token占比：131068 / 659460 = 19.88%\n额外重复句词数贡献：98441 / 127357 = 77.30%"
            }
          ]
        }
      ]
    }
  ]
}
